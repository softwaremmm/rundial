nextflow_process {
    name "Test Process Apply filters"
    script "process/consensus.nf"
    process "apply_filters"

    test("Process run successfully and produce filtered vcfs") {
        when {
            process{
                """
                input[0] = ['sample', "ref", file("$projectDir/data/h37rv_20231215.fa.gz"), file("$projectDir/test_data/unfiltered.vcf")]
                input[1] = file("$projectDir/test_data/filter_params.yml")
                input[2] = "bcftools"
                """
            }
        }

        then {
            assert process.success
            with(process.out.filtered_vcf) {
                assert get(0)[3].contains('alternate-bcftools.vcf.gz')
                assert path(get(0)[3]).md5 == path("$projectDir/test_data/filtered.vcf").md5
            }
        }
    }


    test("Process should generate error if files do not exist") {
        when {
            process{
                """
                input[0] = ['sample', "ref", file("$projectDir/data/h37rv_20231215.fa.gz"), file("$projectDir/test_data/not_exist.vcf")]
                input[1] = file("$projectDir/test_data/filter_params.yml")
                input[2] = "bcftools"
                """
            }
        }

        then {
            assert process.failed
        }
    }

}
