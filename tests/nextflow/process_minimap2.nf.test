nextflow_process {
    name "Test Process minimap2"
    script "process/variant_calling.nf"
    process "minimap2"

    test("Process run successfully and produce alignment") {
        when {
            process{
                """
                input[0] = ['sample', "ref", file("$projectDir/data/h37rv_20231215.fa.gz"), file("$projectDir/test_data/assemblers/ont_simple.fastq.gz")]
                """
            }
        }

        then {
            assert process.success
            assert process.out.sorted_alignment[0][3].contains('final.bam')
        }
    }
}
