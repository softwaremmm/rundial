nextflow_workflow {
    name "Test workflow rundial_with_bcftools"
    script "main.nf"
    workflow "rundial_with_bcftools"

    test("Workflow runs successfully") {
        when {
            workflow{
                """
                input[0] = ['sample', "ref", "$projectDir/data/h37rv_20231215.fa.gz", file("$projectDir/test_data/assemblers/ont_simple.fastq.gz")]
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.final_fasta[0][2].contains('final.fasta')
            assert workflow.out.variants_vcf[0][2].contains('variants.vcf')
            assert workflow.out.all_calls_vcf[0][2].contains('all_calls.vcf')
            assert workflow.out.creation_report_json[0][2].contains('genome_creation_report.json')
        }
    }


    test("Workflow should generate error if files do not exist") {
        when {
            workflow{
                """
                input[0] = ['sample', "ref", "$projectDir/data/h37rv_20231215.fa.gz", file("$projectDir/test_data/assemblers/non_existent.fastq.gz")]
                """
            }
        }

        then {
            assert workflow.failed
        }
    }

}
