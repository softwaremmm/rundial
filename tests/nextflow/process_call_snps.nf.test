nextflow_process {
    name "Test Process call snps"
    script "process/variant_calling.nf"
    process "call_snps"

    test("Process run successfully and produce vcfs - cpus 1") {
        when {
            params {
                test_cpus = 1
            }
            process{
                """
                input[0] = ['sample', "ref", file("$projectDir/data/h37rv_20231215.fa.gz"), file("$projectDir/test_data/assemblers/final.bam")]
                """
            }
        }

        then {
            assert process.success
            assert process.out.gvcf[0][3].contains('calls.gvcf.gz')
            assert path(process.out.gvcf[0][3]).linesGzip[40..-1] == path("$projectDir/test_data/assemblers/snp_calls.gvcf.gz").linesGzip[40..-1]
        }
    }

    test("Process run successfully and produce vcfs - cpus 2") {
        when {
            params {
                test_cpus = 2
            }
            process{
                """
                input[0] = ['sample', "ref", file("$projectDir/data/h37rv_20231215.fa.gz"), file("$projectDir/test_data/assemblers/final.bam")]
                """
            }
        }

        then {
            assert process.success
            assert process.out.gvcf[0][3].contains('calls.gvcf.gz')
            assert path(process.out.gvcf[0][3]).linesGzip[40..-1] == path("$projectDir/test_data/assemblers/snp_calls.gvcf.gz").linesGzip[40..-1]
        }
    }


    test("Process should generate error if files do not exist") {
        when {
            process{
                """
                input[0] = ['sample', "ref", file("$projectDir/data/h37rv_20231215.fa.gz"), file("$projectDir/test_data/assemblers/not_exist.bam")]
                """
            }
        }
        then {
            assert process.failed
        }
    }
}
